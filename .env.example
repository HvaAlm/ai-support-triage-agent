# The app reads exported environment variables; it does not execute or auto-load this file.
APP_MODE=mock
# Docker Compose external task runners: generate a secret with
# python3 -c 'import secrets; print(secrets.token_hex(32))'
N8N_RUNNERS_AUTH_TOKEN=
# Docker Compose n8n/Postgres. Never change N8N_ENCRYPTION_KEY after first start:
# saved n8n credentials are encrypted with it.
POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=
# Public host n8n is reached at (Telegram webhooks), e.g. the cloudflared tunnel host.
N8N_PUBLIC_HOST=
TICKET_PUBLISHER=dry-run
CASE_DATABASE=data/cases.sqlite3
ATTACHMENT_DIR=data/attachments

# Live read-only GitLab retrieval. Use a project-scoped read_api token.
GITLAB_BASE_URL=https://git.example.com
GITLAB_PROJECT_PATH=group/backend
GITLAB_READ_TOKEN=
# Empty means discover the project's default branch.
BACKEND_REF=

# Existing ChatGPT login: codex login
CODEX_BINARY=codex
INVESTIGATION_TIMEOUT_SECONDS=180

# Exact verified Jira field values; credentials belong to the skill's runtime.
TICKET_PROJECT=
TICKET_ISSUE_TYPE=Bug
# Optional override for the provided skill CLI location:
# TICKET_SKILL_SCRIPT=/absolute/path/to/jira/scripts/jira_tool.py

# Telegram transport is online even when investigation uses mock mode.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
